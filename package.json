{
  "name": "turbo-surfers",
  "version": "1.0.0",
  "description": "Turbo Surfers - a LAN multiplayer endless-runner kart racer for phones. Subway Surfers movement, Mario Kart items. Up to 12 players.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --port 8080",
    "skyline": "node skyline/serve.mjs",
    "skyline:bundle": "node skyline/tools/bundle.mjs",
    "skyline:simtest": "node skyline/tools/simtest.mjs"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "private": true
}
